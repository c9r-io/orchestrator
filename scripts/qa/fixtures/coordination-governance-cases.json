{
  "cases": [
    {
      "name": "new-captured-coordination-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-capture"},
        "spec": {
          "steps": [
            {
              "id": "coordinate",
              "behavior": {
                "captures": [
                  {"var": "next_action", "source": "stdout", "json_path": "$.next"}
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "reviewed-cel-governance-is-accepted",
      "expectedAccepted": true,
      "approvedTouches": [
        {
          "step": "publish",
          "kind": "prehook",
          "engine": "cel",
          "expression": "api_publishable == \"true\""
        }
      ],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "allowed-governance"},
        "spec": {
          "steps": [
            {
              "id": "publish",
              "prehook": {
                "engine": "cel",
                "when": "api_publishable == \"true\""
              }
            }
          ]
        }
      }
    },
    {
      "name": "new-generic-safety-variable-consumer-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-generic-safety"},
        "spec": {
          "steps": [
            {
              "id": "safety-review",
              "step_vars": {
                "denial": "last_sandbox_denial_reason"
              }
            }
          ]
        }
      }
    },
    {
      "name": "new-store-input-consumer-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-store-input"},
        "spec": {
          "steps": [
            {
              "id": "restore-state",
              "store_inputs": [
                {
                  "store": "runtime",
                  "key": "legacy_state",
                  "as_var": "legacy_state"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "new-json-path-post-action-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-json-path-post-action"},
        "spec": {
          "steps": [
            {
              "id": "expand",
              "behavior": {
                "post_actions": [
                  {
                    "type": "generate_items",
                    "from_var": "legacy_payload",
                    "json_path": "$.items"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
