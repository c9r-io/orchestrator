{
  "executionCases": [
    {
      "name": "new-command-only-agent-is-rejected",
      "evaluationLayer": "production-manifest-governance",
      "rationale": "Reviewed production manifests must declare an explicit typed driver; this is not the daemon Apply compatibility decision.",
      "expectedAccepted": false,
      "runtimeCompatibility": {
        "accepted": true,
        "warningCode": "legacy_agent_command_deprecated",
        "persistedDriver": "shell/cli"
      },
      "document": {
        "kind": "Agent",
        "metadata": {"name": "legacy-shell"},
        "spec": {
          "capabilities": ["general"],
          "command": "echo ok"
        }
      }
    },
    {
      "name": "explicit-shell-driver-agent-is-accepted",
      "evaluationLayer": "production-manifest-governance",
      "rationale": "Reviewed production manifests accept an explicit shell/cli driver.",
      "expectedAccepted": true,
      "document": {
        "kind": "Agent",
        "metadata": {"name": "typed-shell"},
        "spec": {
          "capabilities": ["general"],
          "command": "echo ok",
          "driver": {
            "provider": "shell",
            "transport": "cli"
          }
        }
      }
    },
    {
      "name": "global-streaming-executor-is-rejected",
      "evaluationLayer": "production-manifest-governance",
      "rationale": "The removed global streaming executor is rejected by both production governance and daemon Apply.",
      "expectedAccepted": false,
      "document": {
        "kind": "RuntimePolicy",
        "metadata": {"name": "legacy-streaming"},
        "spec": {
          "runner": {
            "executor": "streaming"
          }
        }
      }
    }
  ],
  "cases": [
    {
      "name": "new-captured-coordination-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-capture"},
        "spec": {
          "steps": [
            {
              "id": "coordinate",
              "behavior": {
                "captures": [
                  {"var": "next_action", "source": "stdout", "json_path": "$.next"}
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "reviewed-cel-governance-is-accepted",
      "expectedAccepted": true,
      "approvedTouches": [
        {
          "step": "publish",
          "kind": "prehook",
          "engine": "cel",
          "expression": "api_publishable == \"true\""
        }
      ],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "allowed-governance"},
        "spec": {
          "steps": [
            {
              "id": "publish",
              "prehook": {
                "engine": "cel",
                "when": "api_publishable == \"true\""
              }
            }
          ]
        }
      }
    },
    {
      "name": "new-generic-safety-variable-consumer-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-generic-safety"},
        "spec": {
          "steps": [
            {
              "id": "safety-review",
              "step_vars": {
                "denial": "last_sandbox_denial_reason"
              }
            }
          ]
        }
      }
    },
    {
      "name": "new-store-input-consumer-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-store-input"},
        "spec": {
          "steps": [
            {
              "id": "restore-state",
              "store_inputs": [
                {
                  "store": "runtime",
                  "key": "legacy_state",
                  "as_var": "legacy_state"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "new-json-path-post-action-is-rejected",
      "expectedAccepted": false,
      "approvedTouches": [],
      "workflow": {
        "kind": "Workflow",
        "metadata": {"name": "rejected-json-path-post-action"},
        "spec": {
          "steps": [
            {
              "id": "expand",
              "behavior": {
                "post_actions": [
                  {
                    "type": "generate_items",
                    "from_var": "legacy_payload",
                    "json_path": "$.items"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
