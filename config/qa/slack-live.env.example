# Copy to ~/.config/orchestrator/qa/slack-live.env and chmod 600.
# This committed file documents names only. Never put populated values in git.
# The certifier parses this as data and does not source or execute it.

# Common tools and reviewed provider boundary.
ORCHESTRATOR_BIN=/absolute/path/to/orchestrator
SLACK_LIVE_GATEWAY_URL=https://sandbox-gateway.example.test
SLACK_LIVE_OFFICIAL_MANIFEST_PATH=/absolute/path/to/deploy/slack/official-app-manifest.json
SLACK_LIVE_DEDICATED_MANIFEST_PATH=/absolute/path/to/deploy/slack/dedicated-app-manifest.json
SLACK_CERT_TTL_DAYS=30
SLACK_LIVE_TIMEOUT_SECONDS=90

# Reactions must map to two enabled echo-only fixture templates.
SLACK_LIVE_IMPLEMENT_REACTION=eyes
SLACK_LIVE_DOCS_REACTION=white_check_mark
SLACK_LIVE_IMPLEMENT_SKILL_MARKER='$ticket-fix'
SLACK_LIVE_DOCS_SKILL_MARKER='$qa-doc-gen'

# Shared official App: two isolated workspace/daemon installations.
SLACK_LIVE_SHARED_A_DAEMON_DATA=/absolute/path/to/isolated/shared-a-data
SLACK_LIVE_SHARED_A_PROJECT=slack-cert-shared-a
SLACK_LIVE_SHARED_A_CONNECTION_ID=
SLACK_LIVE_SHARED_A_CHANNEL_ID=
SLACK_LIVE_SHARED_A_ACTOR_ID=
# Sandbox-only driver App token with chat:write and reactions:write.
SLACK_LIVE_SHARED_A_DRIVER_BOT_TOKEN=

SLACK_LIVE_SHARED_B_DAEMON_DATA=/absolute/path/to/isolated/shared-b-data
SLACK_LIVE_SHARED_B_PROJECT=slack-cert-shared-b
SLACK_LIVE_SHARED_B_CONNECTION_ID=
SLACK_LIVE_SHARED_B_CHANNEL_ID=
SLACK_LIVE_SHARED_B_ACTOR_ID=
# Optional unless workspace B also runs the automated badge smoke.
SLACK_LIVE_SHARED_B_DRIVER_BOT_TOKEN=

# Dedicated private App installation.
SLACK_LIVE_DEDICATED_DAEMON_DATA=/absolute/path/to/isolated/dedicated-data
SLACK_LIVE_DEDICATED_PROJECT=slack-cert-dedicated
SLACK_LIVE_DEDICATED_CONNECTION_ID=
SLACK_LIVE_DEDICATED_CHANNEL_ID=
SLACK_LIVE_DEDICATED_ACTOR_ID=
SLACK_LIVE_DEDICATED_DRIVER_BOT_TOKEN=
# Provider identifier used only in the private cleanup inventory.
SLACK_LIVE_DEDICATED_APP_ID=

# Never place a Slack Configuration Token, client secret, signing secret,
# Gateway master/enrollment key, OAuth code/state, or callback URL here.
# Dedicated Configuration Tokens are read interactively and passed via stdin.
