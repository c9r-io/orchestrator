# Copy to ~/.config/orchestrator/qa/fr114.env and chmod 600.
# Never put the populated file in this repository.

ORCHESTRATOR_BIN=/absolute/path/to/orchestrator
SLACK_LIVE_DAEMON_DATA=/absolute/path/to/isolated/daemon-data
SLACK_LIVE_PROJECT=fr114-sandbox-a
SLACK_LIVE_CONNECTION_ID=
SLACK_LIVE_CHANNEL_ID=
SLACK_LIVE_ACTOR_ID=

# Token for a separate sandbox-only test-driver App. Required scopes:
# chat:write and reactions:write. Do not reuse the official Orchestrator App.
SLACK_LIVE_DRIVER_BOT_TOKEN=

# These reactions must already be mapped to the fixture templates by an enabled
# Trigger in the selected project. Built-in emoji are recommended for portability.
SLACK_LIVE_IMPLEMENT_REACTION=eyes
SLACK_LIVE_DOCS_REACTION=white_check_mark
SLACK_LIVE_IMPLEMENT_SKILL_MARKER='$ticket-fix'
SLACK_LIVE_DOCS_SKILL_MARKER='$qa-doc-gen'

# Optional. The certifier validates the reviewed manifest when this is set.
SLACK_LIVE_OFFICIAL_MANIFEST_PATH=

# Time allowed for Gateway delivery, route creation, and echo task completion.
SLACK_LIVE_TIMEOUT_SECONDS=90
