{
  "schemaVersion": 1,
  "scope": "every workspace member listed in the root Cargo.toml and its non-test Rust source — its src tree and its Cargo build script — excluding inline cfg(test) modules, files under a tests directory, and files named test*.rs; public API is resolved through the module tree and its re-exports, and driver types through each file's own use statements",
  "decision": {
    "form": "capability-boundary",
    "summary": "DD-147 froze who may declare the driver and who may write SQL. Neither observes the capability underneath both: a crate that is handed a connection runs arbitrary SQL with no rusqlite token in its source, so condition 1 reports it clean and condition 2 counts only what it did once it had one. This ledger freezes the capability itself — who can obtain a connection, and which public API hands one out or requires the caller to already hold one.",
    "threeFacts": {
      "yields": "a public item whose return position names a driver connection type; this is the capability leaving the layer",
      "demands": "a public item whose parameter position names a driver type; a function that demands a connection forces its callers to acquire one, which is how an exempt crate below the layer can push the driver upward past it",
      "holds": "production source outside the layer that calls something classified as yields; the scanned names are derived from the yields set rather than listed, so a name that stops yielding a connection stops being looked for and a new one is looked for the moment it appears"
    },
    "notStatedHere": "who may declare the driver, and how much SQL each file holds. Both are DD-147's, in config/governance/persistence-dependency-ledger.json. A crate calling rusqlite::Connection::open directly must first declare the driver, and condition 1 fails on that."
  },
  "roles": {
    "core": {
      "role": "forbidden",
      "reason": "sits above the layer since FR-130 Phase A moved the persistence code into crates/orchestrator-persistence. persistence-dependency-ledger.json still calls core the persistence layer, which was true when FR-136 wrote it and has not been true since Phase A; core's own driver residual is frozen separately in core-boundary-ledger.json"
    },
    "crates/cli": {
      "role": "forbidden",
      "reason": "no relationship to persistence"
    },
    "crates/daemon": {
      "role": "forbidden",
      "reason": "borrows AsyncDatabase connections in gRPC handlers and opens its own by path in server/secret.rs to satisfy orchestrator-security's API. FR-141 migrates both"
    },
    "crates/gui": {
      "role": "forbidden",
      "reason": "no relationship to persistence"
    },
    "crates/integration-tests": {
      "role": "forbidden",
      "reason": "declares the driver under [dev-dependencies] and asserts against the database directly in tests/trigger_fire.rs, which is legitimate for a test and outside this gate's production scan. Marked forbidden rather than exempt so a production source file added to it would be caught"
    },
    "crates/orchestrator-client": {
      "role": "forbidden",
      "reason": "no relationship to persistence"
    },
    "crates/orchestrator-collab": {
      "role": "forbidden",
      "reason": "no relationship to persistence"
    },
    "crates/orchestrator-config": {
      "role": "forbidden",
      "reason": "no relationship to persistence"
    },
    "crates/orchestrator-persistence": {
      "role": "persistence",
      "reason": "is the layer. Holding the driver here is the decision DD-147 recorded, not a residual. What this ledger governs about it is the opposite direction: what it hands out"
    },
    "crates/orchestrator-runner": {
      "role": "forbidden",
      "reason": "no relationship to persistence"
    },
    "crates/orchestrator-scheduler": {
      "role": "forbidden",
      "reason": "borrows AsyncDatabase connections in scheduling logic and re-exports the capability through its own public API — scheduler/item_generate.rs::create_dynamic_task_items takes a &rusqlite::Connection. FR-141 migrates both"
    },
    "crates/orchestrator-security": {
      "role": "exempt",
      "reason": "core depends on orchestrator-security, not the reverse, so it cannot route through a layer above it, and it opens the orchestrator database by path with its own connection. The exemption covers holding a connection. It does not cover demanding one from its callers: eleven of its public functions take a &Connection, and the four open_conn calls in crates/daemon/src/server/secret.rs exist for no other reason than to build one for them. FR-141 closes that direction and leaves the holding direction exempt"
    },
    "crates/proto": {
      "role": "forbidden",
      "reason": "no relationship to persistence"
    },
    "crates/slack-gateway": {
      "role": "separate-database",
      "reason": "opens SLACK_GATEWAY_DB with no workspace dependencies at all. A different database is not this boundary; scanned by nothing here"
    }
  },
